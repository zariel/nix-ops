; SOA Records
$TTL 5m
$ORIGIN cbannister.casa.
@ IN SOA gateway.cbannister.casa. gateway.cbannister.casa. (
  2026111401       ; serial number; YYYYMMDDNN format
  2h               ; refresh period
  1h               ; retry period
  14d              ; expire time
  5m               ; minimum ttl
)

; NS Records
@                        IN  NS gateway.cbannister.casa.

; LAN
gateway                  IN  A  @GATEWAY_ADDRESS@
gateway-ntp              IN  A  10.5.0.10
gateway-tftp             IN  A  10.5.0.9
gateway-metrics          IN  A  10.5.0.11
gateway-dhcp-dns         IN  A  10.5.0.53
matchbox                 IN  A  10.5.0.8
unifi                    IN  A  10.1.0.23
pikvm                    IN  A  10.1.0.100
pdu                      IN  A  10.1.0.31

; servers
pve-ipmi                 IN  A  10.1.1.30
ipmi.pve                 IN  CNAME  pve-ipmi
pve                      IN  A  10.1.1.31
pbs                      IN  A  10.1.1.32
pve2                     IN  A  10.1.1.41
ash                      IN  A  10.1.1.55

k8s-0                    IN  A  10.254.1.1
k8s-1                    IN  A  10.254.1.3
k8s-2                    IN  A  10.254.1.5
nas                      IN  A  10.254.1.101

am6b                     IN  A  10.1.2.54
rock                     IN  A  10.1.2.60
ropiee                   IN  A  10.1.2.61
dev                      IN  A  10.1.2.15
gaming                   IN  A  10.1.2.16
bc250                    IN  A  10.1.2.57

k8s                      IN  A  10.45.0.100
builder                  IN  A  10.1.1.155

printer                  IN  A  10.1.2.70

dns1 IN A 10.254.53.0
dns2 IN A 10.254.53.2
dns3 IN A 10.254.53.4

beefchunk IN A 10.254.254.10
