; SOA Records
$TTL 3600
$ORIGIN unifi.
@ 3600 IN SOA gateway.cbannister.casa. gateway.cbannister.casa. (
  1793477572         ; serial number (epoch timestamp)
  7200               ; refresh period
  3600               ; retry period
  1209600            ; expire time
  3600               ; minimum ttl
)

; NS Records
@                          IN  NS gateway.cbannister.casa.

; Controller discovery
@                          IN  A  10.1.0.23
