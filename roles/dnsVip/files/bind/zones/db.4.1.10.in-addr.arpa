; Reverse DNS Zone for 10.1.4.0/24 (ROON)
$TTL 1h
$ORIGIN 4.1.10.in-addr.arpa.
@ IN SOA gateway.cbannister.casa. gateway.cbannister.casa. (
  2026112101       ; serial number; YYYYMMDDNN format
  2h               ; refresh period
  1h               ; retry period
  14d              ; expire period
  1h               ; minimum ttl
)

@    IN  NS   gateway.cbannister.casa.

10   IN  PTR  rock.cbannister.casa.
11   IN  PTR  ropiee.cbannister.casa.
12   IN  PTR  ropiee-remote.cbannister.casa.
13   IN  PTR  bluesound-node2i.cbannister.casa.
14   IN  PTR  bluesound-flex-mini.cbannister.casa.
